	$(CC)  -I. -Iinclude -Iproviders/common/include -Iproviders/implementations/include -Icrypto/include -I.. -I../include -I../providers/common/include -I../providers/implementations/include -I../crypto/include  -DAES_ASM -DBSAES_ASM -DCMLL_ASM -DECP_NISTZ256_ASM -DGHASH_ASM -DKECCAK1600_ASM -DMD5_ASM -DMLKEM_AVX2_X86_64_ASM -DOPENSSL_BN_ASM_GF2m -DOPENSSL_BN_ASM_MONT -DOPENSSL_BN_ASM_MONT5 -DOPENSSL_CPUID_OBJ -DOPENSSL_IA32_SSE2 -DOPENSSL_SM3_ASM -DPOLY1305_ASM -DRC4_ASM -DSHA1_ASM -DSHA256_ASM -DSHA512_ASM -DSM4_ASM -DVPAES_ASM -DWHIRLPOOL_ASM -DX25519_ASM $(LIB_CFLAGS) $(LIB_CPPFLAGS) -MMD -MF crypto/cms/libcrypto-lib-cms_ess.d.tmp -c -o $@ ../crypto/cms/cms_ess.c
	@touch crypto/cms/libcrypto-lib-cms_ess.d.tmp
	@if cmp crypto/cms/libcrypto-lib-cms_ess.d.tmp crypto/cms/libcrypto-lib-cms_ess.d > /dev/null 2> /dev/null; then \
