	( SRCTOP=$(SRCDIR) \
	  BLDTOP=$(BLDDIR) \
	  PERL="$(PERL)" \
	  FIPSKEY="$(FIPSKEY)" \
	  EXE_EXT= \
	  $(PERL) $(SRCDIR)/test/run_tests.pl $(TESTS) )
	@ : 

