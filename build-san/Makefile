	$(CC)  -I. -Icrypto -Iinclude -Iproviders/implementations/include -Iproviders/common/include -Iproviders/fips/include -I.. -I../crypto -I../include -I../providers/implementations/include -I../providers/common/include -I../providers/fips/include  -DAES_ASM -DBSAES_ASM -DECP_NISTZ256_ASM -DFIPS_MODULE -DGHASH_ASM -DKECCAK1600_ASM -DMLKEM_AVX2_X86_64_ASM -DOPENSSL_BN_ASM_GF2m -DOPENSSL_BN_ASM_MONT -DOPENSSL_BN_ASM_MONT5 -DOPENSSL_CPUID_OBJ -DOPENSSL_IA32_SSE2 -DSHA1_ASM -DSHA256_ASM -DSHA512_ASM -DVPAES_ASM -DX25519_ASM $(LIB_CFLAGS) $(LIB_CPPFLAGS) -MMD -MF crypto/aes/libfips-lib-aes_ecb.d.tmp -c -o $@ ../crypto/aes/aes_ecb.c
	@touch crypto/aes/libfips-lib-aes_ecb.d.tmp
	@if cmp crypto/aes/libfips-lib-aes_ecb.d.tmp crypto/aes/libfips-lib-aes_ecb.d > /dev/null 2> /dev/null; then \
		rm -f crypto/aes/libfips-lib-aes_ecb.d.tmp; \
	else \
		mv crypto/aes/libfips-lib-aes_ecb.d.tmp crypto/aes/libfips-lib-aes_ecb.d; \
	fi
